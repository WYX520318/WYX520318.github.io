1ea\u5df1\u72ec\u7279\u6b63\u786e\u7684\u7231\u60c5\u89c2\uff0c\u53cb\u60c5\u89c2\n\u6240\u4ee5\u6211\u6ce8\u5b9a\u957f\u4e00\u6bb5\u65f6\u95f4\u90fd\u5fc5\u987b\u662f\u5b64\u72ec\u7684\n\u9664\u975e\u6211\u628a\u4ee5\u524d\u7684\u6211\u6740\u6b7b\uff0c\u628a\u73b0\u5728\u7684\u6211\u6740\u6b7b\n\u53bb\u8fce\u63a5\u4f60\u4eec\u5e7f\u6cdb\u7684\u7231\u60c5\u89c2\uff0c\u4e16\u754c\u89c2\uff0c\u53cb\u60c5\u89c2\n\u4f46\u6211\u6c38\u8fdc\u4e0d\u4f1a\u8fd9\u6837\u505a\n\u6211\u6c38\u8fdc\u90fd\u662f\u4e00\u4e2a\u6700\u521d\u7684\u4eba\n\u6211\u4e0d\u4f1a\u4e3a\u4e86\u4efb\u4f55\u4e8b\u6211\u6765\u59a5\u534f\n\u751a\u81f3\u8981\u6539\u53d8\u81ea\u5df1\u7684\u601d\u60f3\n\n\u5148\u4e0d\u8981\u8bf4\u8fd9\u4e9b\u5566\uff0c\u8fd9\u53c8\u4e0d\u662f\u4e13\u95e8\u6765\u63a2\u8ba8\u53cb\u60c5\uff0c\u7231\u60c5\u7684\n\u4eca\u5929\u6211\u5728\u5c1d\u8bd5\u5199\u8bfb\u4e66\u7b14\u8bb0\n\u4f46\u6211\u627f\u8ba4\u8fd9\u8ba9\u6211\u611f\u5230\u65e0\u4ece\u4e0b\u624b\n\u6211\u627f\u8ba4\u6211\u6ca1\u6709\u63a5\u89e6\u8fc7\u5199\u4f5c\n\u54ea\u6015\u73b0\u5728\u6211\u5199\u8fd9\u4e9b\u6587\u5b57\uff0c\u4e5f\u5355\u5355\u53ea\u662f\u628a\u6211\u5185\u5fc3\u6240\u60f3\u7684\u4e8b\u60c5\u5199\u4e0b\u6765\n\u662f\u4e3a\u4e86\u7ed9\u6211\u81ea\u5df1\u770b\uff0c\u800c\u4e0d\u662f\u4e3a\u4e86\u7ed9\u4f60\u4eec\u770b\n\n\u5934\u8111\u4e0a\u7684\u8499\u8499\u611f,\u8ff7\u832b\u611f\u4ec0\u4e48\u65f6\u5019\u624d\u80fd\u6d88\u9664\uff1f\n\u6211\u4e0d\u77e5\u9053,\u4e5f\u8bb8\u5427\u8ff7\u832b\u7684\u6218\u6597\u4e0b\u53bb\u4e0d\u4f1a\u6709\u597d\u7ed3\u679c\n\u4f46\u5bf9\u4e8e\u6211\u6765\u8bf4\uff0c\u5982\u679c\u6211\u505c\u6ede\u4e0d\u524d\u7684\u8bdd\n\u5982\u679c\u6211\u53d8\u6210\u4e86\u6211\u4e3a\u81ea\u5df1\u800c\u6d3b\uff0c\u4e3a\u6211\u81ea\u5df1\u7684\u5229\u76ca\u800c\u6d3b\u7684\u4eba\n\u53d8\u6210\u72e1\u8bc8\uff0c\u5fd8\u8bb0\u4e86\u6211\u6700\u521d\u60f3\u4e3a\u5168\u4eba\u7c7b\u89e3\u653e\u4e8b\u4e1a\u505a\u6597\u4e89\u7684\u60f3\u6cd5\n\u5982\u679c\u6211\u90a3\u65f6\u5019\u610f\u8bc6\u5230\u4e86\u4e00\u70b9\uff0c\u6211\u4f1a\u4eb2\u624b\u628a\u81ea\u5df1\u6740\u6b7b\u7684\n\u505c\u6ede\u4e0d\u524d\u8ba9\u6211\u611f\u89c9\u5230\u8ff7\u832b,\u611f\u89c9\u5230\u7126\u8651\uff0c\u611f\u89c9\u5230\u6291\u90c1\n\u800c\u4eca\u5929\u8fd9\u4e00\u5207\u7684\u751f\u6d3b\u81f3\u5c11\u8ba9\u6211\u597d\u53d7\u4e86\u4e00\u70b9\n\n## \u7259\u9f7f\u597d\u75bc\n\u6211\u7684\u5b66\u4e60\u8def\u9014\u5f88\u714e\u71ac\uff0c\u56e0\u4e3a\u6211\u517b\u6210\u4e86\u61d2\u60f0\u7684\u4e60\u60ef\n\u6211\u7684\u5934\u8111\u5145\u6ee1\u4e86\u5065\u5fd8\n\u8fd9\u610f\u5473\u6211\u5b66\u4e60\u7684\u4e1c\u897f\u5f88\u5feb\u5c31\u4f1a\u5fd8\u6389\n\u6211\u9700\u8981\u4ed8\u51fa\u66f4\u957f\u7684\u5b66\u4e60\u65f6\u95f4\n\n\u4f46\u5e76\u4e0d\u662f\u771f\u6b63\u7684\u9057\u5fd8\u5b83\u4eec\u9690\u85cf\u4e8e\u6211\u7684\u8111\u6d77\u6df1\u5904\n\u5982\u679c\u6211\u80fd\u5199\u51fa\u8bfb\u4e66\u7b14\u8bb0\u7684\u8bdd\n\u7ecf\u5e38\u7ffb\u9605\u7684\u8bdd\u5e94\u8be5\u4e5f\u662f\u4f1a\u8bb0\u4f4f\u7684\n\n\u6211\u73b0\u5728\u6700\u5927\u7684\u672a\u6765\u7684\u56f0\u5883\u662f\u6559\u6761\u4e3b\u4e49\n\u6211\u6ca1\u6709\u53ef\u4ee5\u8fdb\u884c\u5b9e\u8df5\u7684\u5730\u65b9\n\u4e66\u7c4d\u5927\u591a\u6570\u662f\u6709\u5386\u53f2\u7684\u5c40\u9650\u6027\u7684\n\u4e2d\u56fd\u53d8\u5316\u5f88\u5927,\u4e00\u4e9b\u7684\u7279\u6b8a\u60c5\u51b5\u8fd8\u65e0\u6cd5\u7528\u4e66\u7c4d\u6765\u89e3\u7b54\n\n\u5982\u679c\u4ee5\u540e\u53c2\u52a0\u8fd0\u52a8\u7684\u8bdd\uff0c\u6211\u4f1a\u4ec0\u4e48\u6837\u7684\uff1f\n\u597d\u60f3\u554a\n\u597d\u8ff7\u832b\n\n\u6211\u4f1a\u4e0d\u4f1a\u534a\u9014\u653e\u5f03\u5462\uff1f\u6211\u4f1a\u4e0d\u4f1a\u4e0d\u575a\u6301\u6211\u6765\u9605\u8bfb\u4e86\uff1f\u6211\u4f1a\u4e0d\u4f1a\u6210\u4e3a\u6545\u4f5c\u9ad8\u7384\u7684\u54f2\u5b66\u5bb6\uff1f\u7528\u7740\u4e00\u4e9b\u54f2\u5b66\u540d\u8bcd\u6765\u9ebb\u75f9\u81ea\u5df1\u6b3a\u9a97\u81ea\u5df1\uff1f\n\u6211\u4f1a\u4e0d\u4f1a\u5c31\u8fd9\u6837\u5c48\u670d\u4e8e\u4e16\u4fd7\uff1f\u6210\u4e3a\u4e00\u540d\u6253